{
  "gnss": {
    "gnss_topic": "/gps_na/odom",
    "gnss_msg_type": "nav_msgs/msg/Odometry",
    "min_baseline": 5.0,
    "enable_orientation_prior": false,
    // Diagnostic: very loose 2D translation anchor only, no orientation constraint.
    // sigma = 1/sqrt(precision) -> 1m sigma on x,y; z effectively unconstrained.
    "prior_inf_scale": [
      1e6,
      1e6,
      1e-6
    ],
    "orientation_prior_inf_scale": [
      1e-6,
      1e-6,
      1e2
    ],
    // Software antenna -> IMU lever-arm compensation.
    //
    // Set to FALSE for tightly-coupled INS receivers (Novatel SPAN, Septentrio
    // AsteRx-i, Atlas Duo, etc.) where the firmware already resolves antenna
    // observations to the IMU origin internally via LEVERARMCONFIG. Applying
    // the correction here as well would double-compensate.
    //
    // Set to TRUE only for raw-GNSS publishers that report antenna-frame
    // position. The lever arm is then read from the URDF using urdf_gnss_frame
    // below.
    //
    // Current vehicle (AV-24 Cybertruck, Novatel INS): firmware compensates,
    // so this stays false. Leaving the urdf_gnss_frame populated would still
    // be ignored, but we also blank it for belt-and-suspenders clarity.
    "enable_lever_arm": false,
    // URDF link name of the GNSS antenna. Only consulted when
    // enable_lever_arm is true. Empty string means "no lever arm".
    // Examples: "gps_antenna_top", "gps_antenna_front".
    "urdf_gnss_frame": ""
  }
}
