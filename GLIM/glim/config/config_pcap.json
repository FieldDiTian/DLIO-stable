{
  /*** PCAP source configuration (used by glim_pcap_rosbag) ***
  // iris_data_src_port         : Iris UDP source port (used to filter only data packets)
  // inactivity_sec             : Per-scan finalization timeout in seconds. Same value is
  //                              used as `tail_ns` for bag/pcap window math; do not diverge.
  // scan_reorder_lookahead_ns  : Cross-lidar reorder lookahead applied to assembled scans
  //                              before they leave the pcap reader.
  //
  // Lidars are described by parallel arrays so glim::Config can deserialize them.
  // lidar_ips        : Source IP for each lidar (Iris device IP).
  // lidar_topics     : Output ROS topic for each lidar.
  // lidar_frame_ids  : Output frame_id for each lidar (must match URDF / config_sensors).
  // lidar_dst_ports  : Destination UDP port (matches the Iris driver config per device).
  */
  "pcap": {
    "iris_data_src_port": 4371,
    "inactivity_sec": 0.05,
    "scan_reorder_lookahead_ns": 200000000,

    "lidar_ips":       ["10.42.37.20",          "10.42.37.21",         "10.42.37.22"],
    "lidar_topics":    ["/luminar_front/points", "/luminar_left/points", "/luminar_right/points"],
    "lidar_frame_ids": ["luminar_front",        "luminar_left",        "luminar_right"],
    "lidar_dst_ports": [4370, 4371, 4372]
  }
}
