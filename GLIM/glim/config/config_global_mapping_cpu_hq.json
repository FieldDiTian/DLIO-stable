{
  /*** High-quality CPU global mapping for GPU odometry runs ***
  // Intended route:
  //   GPU odometry -> passthrough sub-mapping -> CPU VGICP global mapping.
  //
  // This keeps the odometry frontend quality settings intact and avoids
  // building whole-map IntegratedVGICPFactorGPU factors during global mapping.
  */
  "global_mapping": {
    "so_name": "libglobal_mapping.so",

    // General settings
    "enable_imu": true,
    "enable_optimization": true,
    "init_pose_damping_scale": 1e10,

    // Relative pose factors
    "create_between_factors": true,
    "between_registration_type": "GICP",
    "max_between_refinement_trans": 5.0,
    "max_between_refinement_rot": 0.5,

    // Registration error factors
    "registration_error_factor_type": "VGICP",
    "randomsampling_rate": 1.0,
    "submap_voxel_resolution": 0.5,
    "submap_voxelmap_levels": 2,
    "submap_voxelmap_scaling_factor": 2.0,
    "max_implicit_loop_distance": 30.0,
    "min_implicit_loop_overlap": 0.2,

    // Optimizer settings
    "use_isam2_dogleg": false,
    "isam2_relinearize_skip": 1,
    "isam2_relinearize_thresh": 0.1
  }
}
