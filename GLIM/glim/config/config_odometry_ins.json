{
  /*** INS-driven odometry with optional light LiDAR refinement ***
  // Pose state is sourced from an external nav_msgs/msg/Odometry topic
  // (in the all-P1 design: /gps_p1/filtered_odom -- Atlas FusionEngine INS
  // at gps_antenna_top in the "map" world frame).
  //
  // INIT GATING: insert_frame() calls wait_for_ins_coverage(t_start, t_end)
  // before doing anything with a LiDAR scan. It polls the ins_buffer for
  // up to max_ins_wait_seconds and requires that the buffer span covers
  // the scan window. If not, the scan is SKIPPED and logged as
  // "INS data does not cover frame [...]; skipping". Consequence: while
  // Atlas's INS is not publishing (cold start, pre-RTK alignment,
  // GNSS loss), GLIM accumulates IMU into its buffer but never inserts
  // any LiDAR frame into the map -- no map points are committed.
  //
  // The first LiDAR frame that gets inserted is therefore the first
  // scan whose timestamp falls inside Atlas's INS coverage. The map is
  // born at that pose, in Atlas's map frame (gps_antenna_top body).
  //
  // RTK quality is NOT gated here -- if Atlas publishes pre-RTK dead-
  // reckoning, GLIM consumes it. To require RTK before any data lands,
  // run a tiny republisher upstream that drops samples whose
  // pose.covariance exceeds your threshold (the same gate gicp_localization
  // uses on the gt_odom buffer; see localization/rtk_gate/* in the GICP
  // yaml for reference covariance values from Atlas).
  //
  // Each LiDAR frame is deskewed using INS-interpolated poses across the
  // scan window. If enable_lidar_refinement is true, a single-step GICP
  // solve refines the pose against a rolling iVox target -- but only if
  // the refinement delta stays within max_refinement_(translation|rotation).
  // Otherwise the raw INS pose is kept (failure-mode behavior for
  // sparse-feature regions).
  //
  // Note: this estimator emits frames in the world frame defined by the
  // INS topic header.frame_id ("map" with Atlas, geo-referenced via Atlas's
  // own ENU origin), so resulting maps will be geo-referenced.
  */
  "odometry_estimation": {
    "so_name": "libodometry_estimation_ins.so",
    // INS frame mapping (URDF). If urdf_ins_frame is blank here, falls back to sensors.urdf_ins_frame in config_sensors.json.
    "urdf_ins_frame": "gps_antenna_top",
    // Refinement
    "enable_lidar_refinement": false,
    "max_refinement_translation": 0.30,
    "max_refinement_rotation": 0.05,
    "refinement_max_iterations": 5,
    "ins_prior_sigma_trans": 0.05,
    "ins_prior_sigma_rot": 0.0087,
    "target_downsampling_rate": 0.1,
    // Target voxelmap (iVox)
    "ivox_resolution": 0.5,
    "ivox_min_dist": 0.1,
    "ivox_lru_thresh": 200,
    // INS / sync
    "max_ins_wait_seconds": 0.05,
    "ins_buffer_seconds": 2.0,
    // Misc
    "save_imu_rate_trajectory": true,
    "num_threads": 2
  }
}
